    @if($gradeSelectionLocked)
      <script>
        (function () {
          var lock   = document.querySelector('[data-grade-lock]');
          var form   = document.querySelector('[data-grade-lock-form]');
          var cs     = document.getElementById('glm-custom-select');
          var trigger = document.getElementById('glm-cs-trigger');
          var valueEl = document.getElementById('glm-cs-value');
          var dropdown = document.getElementById('glm-cs-dropdown');
          var hidden  = document.getElementById('locked-grade-hidden');
          var submitBtn = document.getElementById('glm-submit-btn');

          if (!lock || !form || !cs) return;

          document.documentElement.classList.add('grade-lock-active');
          document.body.classList.add('grade-lock-active');

          /* ---- Init: if old() has a value, mark it selected ---- */
          var preselected = hidden ? hidden.value : '';
          var allOptions = cs.querySelectorAll('.glm-cs-option');

          function selectOption(el) {
            allOptions.forEach(function(o) {
              o.classList.remove('is-selected');
              o.setAttribute('aria-selected', 'false');
            });
            el.classList.add('is-selected');
            el.setAttribute('aria-selected', 'true');
            valueEl.textContent = el.textContent.trim();
            valueEl.classList.remove('is-placeholder');
            if (hidden) hidden.value = el.dataset.value;
            if (submitBtn) submitBtn.disabled = false;
            closeDropdown();
          }

          if (preselected) {
            allOptions.forEach(function(o) {
              if (o.dataset.value === preselected) {
                o.classList.add('is-selected');
                valueEl.textContent = o.textContent.trim();
                valueEl.classList.remove('is-placeholder');
                if (submitBtn) submitBtn.disabled = false;
              }
            });
          } else {
            valueEl.classList.add('is-placeholder');
          }

          /* ---- Open / close ---- */
          function openDropdown() {
            cs.setAttribute('aria-expanded', 'true');
            var selected = dropdown.querySelector('.is-selected');
            if (selected) selected.scrollIntoView({ block: 'nearest' });
          }
          function closeDropdown() {
            cs.setAttribute('aria-expanded', 'false');
          }
          function toggleDropdown() {
            cs.getAttribute('aria-expanded') === 'true' ? closeDropdown() : openDropdown();
          }

          trigger.addEventListener('click', toggleDropdown);
          cs.addEventListener('keydown', function(e) {
            var open = cs.getAttribute('aria-expanded') === 'true';
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleDropdown(); }
            if (e.key === 'Escape') { e.preventDefault(); closeDropdown(); }
            if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && open) {
              e.preventDefault();
              var opts = Array.from(allOptions);
              var focused = dropdown.querySelector('.is-focused');
              var idx = focused ? opts.indexOf(focused) : -1;
              if (focused) focused.classList.remove('is-focused');
              idx = e.key === 'ArrowDown' ? Math.min(idx + 1, opts.length - 1) : Math.max(idx - 1, 0);
              opts[idx].classList.add('is-focused');
              opts[idx].scrollIntoView({ block: 'nearest' });
            }
            if (e.key === 'Enter') {
              var focused = dropdown.querySelector('.is-focused');
              if (focused) selectOption(focused);
            }
          });

          allOptions.forEach(function(opt) {
            opt.addEventListener('click', function() { selectOption(opt); });
            opt.addEventListener('mouseenter', function() {
              allOptions.forEach(function(o) { o.classList.remove('is-focused'); });
              opt.classList.add('is-focused');
            });
          });

          /* Close on outside click */
          document.addEventListener('click', function(e) {
            if (!cs.contains(e.target)) closeDropdown();
          });

          /* Trap Escape — keep modal open */
          document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
              event.preventDefault();
              event.stopPropagation();
              closeDropdown();
              cs.focus();
            }
          }, true);

          lock.addEventListener('click', function (event) {
            if (event.target === lock || event.target.classList.contains('grade-lock-modal__veil')) {
              event.preventDefault();
              cs.focus();
            }
          });

          form.addEventListener('submit', function () {
            if (!hidden || !hidden.value) return false;
            var button = form.querySelector('button[type="submit"]');
            if (button) button.classList.add('is-loading');
          });
        })();
      </script>
    @endif
  </body>
</html>


